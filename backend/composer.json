{
    "name": "jenni-khoe-mua/backend",
    "description": "Laravel 11 API backend",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "barryvdh/laravel-dompdf": "*",
        "laravel/framework": "^13.0",
        "laravel/pail": "^1.2",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "dev-start": "php artisan serve"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}